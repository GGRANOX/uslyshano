# Публичные — попадают в клиентский бандл, секретов тут быть не должно
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Только сервер (Route Handlers) — НИКОГДА не префиксовать NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
OPENAI_API_KEY=sk-...

# Пароль админ-панели (/admin). HTTP Basic Auth, логин любой, важен пароль.
# Без этой переменной /admin недоступна вообще (Basic Auth не проходит).
ADMIN_PASSWORD=change-me
