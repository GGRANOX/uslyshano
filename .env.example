# Публичные — попадают в клиентский бандл, секретов тут быть не должно
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Реквизиты Kaspi для магазина декораций и поддержки (Фаза 3). Оба опциональны
# по отдельности — если не задан QR, показывается только номер, и наоборот.
NEXT_PUBLIC_KASPI_PHONE=+7 700 000 00 00
NEXT_PUBLIC_KASPI_QR_URL=/kaspi-qr.png

# Только сервер (Route Handlers) — НИКОГДА не префиксовать NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
OPENAI_API_KEY=sk-...

# Пароль админ-панели (/admin). HTTP Basic Auth, логин любой, важен пароль.
# Без этой переменной /admin недоступна вообще (Basic Auth не проходит).
ADMIN_PASSWORD=change-me
